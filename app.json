{
  "name": "HDmovie4u STREAMING BOT",
  "description": "A Pyrogram Telegram bot to Stream And Download.",
  "keywords": [
    "telegram",
    "stream",
    "web",
    "pyrogram",
    "aiohttp",
    "python",
    "plugin",
    "modular",
    "media",
    "bot"
  ],
  "repository": "https://github.com/TECHNICAL-RB/HDmovie4u-Streaming",
  "success_url": "/",
  "logo": "https://i.ibb.co/1tMJ8FgN/image.jpg",
  "website": "https://t.me/",
  "env": {
    "ENV": {
      "description": "Set this to True if you don't want to crash the bot",
      "value": "True"
    },
    "APP_NAME": {
      "description": "Copy-Paste the app name that you just typed above."
    },
    "API_ID": {
      "description": "Get this value from https://my.telegram.org"
    },
    "API_HASH": {
      "description": "Get this value from https://my.telegram.org"
    },
    "BOT_TOKEN": {
      "description": "Get this value from @BotFather"
    },
    "BIN_CHANNEL": {
      "description": "The BIN Channel ID. Read the readme for more info about this var"
    },
    "DATABASE_URL": {
      "description": "MongoDB URI for saving User IDs when they first Start the Bot."
    },
    "OWNER_ID": {
      "description": "Your Telegram User ID like 1234509"
    },
    "BANNED_CHANNELS": {
      "description": "Put IDs of Banned Channels where bot will not work. Separate with Space.",
      "required": false
    },
    "UPDATES_CHANNEL": {
      "description": "Put a Public Channel Username without @. Use None to disable.",
      "value": "None",
      "required": false
    },
    "OWNER_USERNAME": {
      "description": "Enter your username without @."
    },
    "SLEEP_THRESHOLD": {
      "description": "Floodwait Sleep timer.",
      "required": false
    },
    "WORKERS": {
      "description": "Number of workers.",
      "required": false
    },
    "PORT": {
      "description": "Port that you want your webapp to be listened to.",
      "value": "8080",
      "required": false
    },
    "NO_PORT": {
      "description": "If you don't want your port to be displayed.",
      "value": "False",
      "required": false
    },
    "HAS_SSL": {
      "description": "Default value is True",
      "value": "True",
      "required": false
    },
    "MY_PASS": {
      "description": "Leave empty if you don't need password protection.",
      "value": "None",
      "required": false
    },
    "BIND_ADRESS": {
      "description": "Web server bind address.",
      "required": false
    },
    "FQDN": {
      "description": "Fully Qualified Domain Name.",
      "required": false
    },
    "name": {
      "description": "Session Name for Bot.",
      "value": "HDmovie4u-Streaming",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
